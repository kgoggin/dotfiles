#!/bin/bash
# Delete merged branches, asking before removing their linked worktrees.
set -u

# Git locks every stale ref in one transaction when pruning. Case-only names
# can share a lock filename on macOS; separate transactions avoid that clash.
prune_case_collisions() {
    local fetch_specs server_refs tracking_refs collisions old_oid ref
    fetch_specs=$(git config --get-all remote.origin.fetch) || return 1
    case "$fetch_specs" in
        '+refs/heads/*:refs/remotes/origin/*'|'refs/heads/*:refs/remotes/origin/*') ;;
        *) return 1 ;; # Leave custom mappings and negative refspecs to Git.
    esac
    server_refs=$(git ls-remote --heads origin) || return 1
    tracking_refs=$(git for-each-ref --format='%(objectname) %(refname) %(symref)' \
        refs/remotes/origin/) || return 1
    collisions=$(printf '%s\n%s\n' "$server_refs" "$tracking_refs" | LC_ALL=C awk '
        $2 ~ /^refs\/heads\// {
            # Preserve the entire case-folded group if any variant is live.
            live[tolower("refs/remotes/origin/" substr($2, 12))] = 1
            next
        }
        $2 ~ /^refs\/remotes\/origin\// {
            key = tolower($2)
            count[key]++
            refs[++n] = $2
            oids[n] = $1
            groups[n] = key
            if (NF > 2) live[key] = 1 # Never delete symbolic refs.
        }
        END {
            for (i = 1; i <= n; i++)
                if (count[groups[i]] > 1 && !live[groups[i]])
                    print oids[i], refs[i]
        }
    ') || return 1
    [[ -n "$collisions" ]] || return 1
    printf 'Pruning stale refs with case-colliding names one at a time.\n'
    while IFS=' ' read -r old_oid ref; do
        # Expected values protect concurrent updates; never remove lock files.
        git update-ref --no-deref -d "$ref" "$old_oid" || return 1
        printf ' * [pruned individually] %s\n' "${ref#refs/remotes/}"
    done <<< "$collisions"
}

dry_run=false
case "${1-}" in
    --dry-run) dry_run=true ;;
    '') ;;
    *) printf 'Usage: git cleanup [--dry-run]\n' >&2; exit 2 ;;
esac

current_worktree=$(git rev-parse --show-toplevel) || exit 1
current_branch=$(git symbolic-ref --quiet HEAD || true)
current_branch=${current_branch#refs/heads/}
prune_failed=false
if $dry_run; then
    git remote prune --dry-run origin || prune_failed=true
    git worktree prune --dry-run || exit 1
else
    git remote prune origin || prune_failed=true
    if $prune_failed && prune_case_collisions; then
        printf 'Case-colliding stale refs removed; retrying normal remote pruning.\n'
        git remote prune origin && prune_failed=false
    fi
    git worktree prune || exit 1
fi
status=0
if $prune_failed; then
    printf 'Remote ref pruning failed; continuing with local branch and worktree cleanup.\n' >&2
    status=1
fi
branches=$(git branch --format='%(refname:lstrip=2)' --merged=HEAD) || exit 1

# NUL-delimited porcelain preserves spaces, newlines, and quoted path names.
worktree_paths=()
worktree_branches=()
while IFS= read -r -d '' field; do
    case "$field" in
        'worktree '*)
            worktree_paths+=("${field#worktree }")
            worktree_branches+=('')
            ;;
        'branch refs/heads/'*)
            worktree_branches[${#worktree_paths[@]}-1]=${field#branch refs/heads/}
            ;;
    esac
done < <(git worktree list --porcelain -z)

# Squash/rebase merges do not preserve ancestry. Only trust a merged PR when
# its exact head matches the local branch and its merge commit is in HEAD.
github_repo=''
origin_url=$(git config --get remote.origin.url)
case "$origin_url" in
    git@github.com:*) github_repo=${origin_url#git@github.com:} ;;
    https://github.com/*) github_repo=${origin_url#https://github.com/} ;;
    ssh://git@github.com/*) github_repo=${origin_url#ssh://git@github.com/} ;;
esac
github_repo=${github_repo%.git}
squash_branches=()
squash_tips=()
if [[ -n "$github_repo" && -n "$current_branch" && ${#worktree_paths[@]} -gt 1 ]]; then
    if ! command -v gh >/dev/null 2>&1; then
        printf 'GitHub CLI unavailable; checking Git ancestry only.\n' >&2
    elif prs=$(gh pr list --repo "$github_repo" --state merged --base "$current_branch" \
        --limit 1000 --json headRefName,headRefOid,mergeCommit,number,isCrossRepository \
        --jq '.[] | select(.isCrossRepository == false) | [.headRefName, .headRefOid, .mergeCommit.oid, .number] | @tsv'); then
        while IFS=$'\t' read -r branch tip merge_commit pr; do
            [[ -n "$branch" && -n "$tip" && -n "$merge_commit" ]] || continue
            linked=false
            for checked_out in "${worktree_branches[@]}"; do
                [[ "$checked_out" == "$branch" ]] && linked=true
            done
            $linked || continue
            local_tip=$(git rev-parse --verify "refs/heads/$branch" 2>/dev/null) || continue
            [[ "$local_tip" == "$tip" ]] || continue
            git merge-base --is-ancestor "$tip" HEAD 2>/dev/null && continue
            git merge-base --is-ancestor "$merge_commit" HEAD 2>/dev/null || continue
            # A branch can have multiple merged PRs; include it only once.
            duplicate=false
            for ((j=0; j<${#squash_branches[@]}; j++)); do
                [[ "${squash_branches[j]}" == "$branch" ]] && duplicate=true
            done
            $duplicate && continue
            squash_branches+=("$branch")
            squash_tips+=("$tip")
            branches+=$'\n'"$branch"
            printf 'Found linked branch %s from merged PR #%s.\n' "$branch" "$pr"
        done <<< "$prs"
    else
        printf 'Could not check GitHub for squash/rebase merges; checking Git ancestry only.\n' >&2
    fi
fi

# Keep branch enumeration on a separate descriptor so prompts read user input.
while IFS= read -r branch <&3; do
    case "$branch" in
        ''|main|develop) continue ;;
    esac
    [[ "$branch" == "$current_branch" ]] && continue

    squash_tip=''
    for ((i=0; i<${#squash_branches[@]}; i++)); do
        [[ "${squash_branches[i]}" == "$branch" ]] && squash_tip=${squash_tips[i]}
    done

    # The first entry is the main worktree; never try to remove it.
    protected=false
    for ((i=0; i<${#worktree_paths[@]}; i++)); do
        if [[ "${worktree_branches[i]}" == "$branch" ]] &&
           { [[ $i == 0 ]] || [[ "${worktree_paths[i]}" == "$current_worktree" ]]; }; then
            protected=true
        fi
    done
    if $protected; then
        printf 'Keeping %s: checked out in the main or current worktree.\n' "$branch"
        continue
    fi

    keep=false
    for ((i=0; i<${#worktree_paths[@]}; i++)); do
        [[ "${worktree_branches[i]}" == "$branch" ]] || continue
        path=${worktree_paths[i]}
        if $dry_run; then
            printf 'Would remove worktree "%s" and delete merged branch %s.\n' "$path" "$branch"
            keep=true
            continue
        fi
        while true; do
            printf 'Remove worktree "%s" and delete merged branch "%s"? [y/N] ' "$path" "$branch"
            answer=''
            if ! IFS= read -r answer; then
                printf '\n'
                answer=n
            fi
            case "$answer" in
                y|Y|yes|YES|Yes)
                    if [[ -n "$squash_tip" ]] &&
                       [[ "$(git rev-parse --verify "refs/heads/$branch")" != "$squash_tip" ]]; then
                        printf 'Keeping %s: branch changed since the merged PR check.\n' "$branch" >&2
                        keep=true
                        status=1
                        break
                    fi
                    if ! git worktree remove -- "$path"; then
                        printf 'Keeping %s: worktree removal failed.\n' "$branch" >&2
                        keep=true
                        status=1
                    fi
                    break
                    ;;
                ''|n|N|no|NO|No)
                    printf 'Keeping worktree and branch %s.\n' "$branch"
                    keep=true
                    break
                    ;;
                *) printf 'Please answer y or n.\n' ;;
            esac
        done
        $keep && break
    done
    $keep && continue
    if $dry_run; then
        printf 'Would delete merged branch %s.\n' "$branch"
    elif [[ -n "$squash_tip" ]]; then
        if [[ "$(git rev-parse --verify "refs/heads/$branch")" == "$squash_tip" ]]; then
            git branch -D -- "$branch" || status=1
        else
            printf 'Keeping %s: branch changed since the merged PR check.\n' "$branch" >&2
            status=1
        fi
    else
        git branch -d -- "$branch" || status=1
    fi
done 3<<< "$branches"
exit "$status"
