#!/bin/bash
# Clean up merged branches and idle worktrees, retaining idle branches.
set -u

# Git locks every stale ref in one transaction when pruning. Case-only names
# can share a lock filename on macOS; separate transactions avoid that clash.
prune_case_collisions() {
    local fetch_specs server_refs tracking_refs collisions old_oid ref
    fetch_specs=$(git config --get-all remote.origin.fetch) || return 1
    case "$fetch_specs" in
        '+refs/heads/*:refs/remotes/origin/*'|'refs/heads/*:refs/remotes/origin/*') ;;
        *) return 1 ;; # Leave custom mappings and negative refspecs to Git.
    esac
    server_refs=$(git ls-remote --heads origin) || return 1
    tracking_refs=$(git for-each-ref --format='%(objectname) %(refname) %(symref)' \
        refs/remotes/origin/) || return 1
    collisions=$(printf '%s\n%s\n' "$server_refs" "$tracking_refs" | LC_ALL=C awk '
        $2 ~ /^refs\/heads\// {
            # Preserve the entire case-folded group if any variant is live.
            live[tolower("refs/remotes/origin/" substr($2, 12))] = 1
            next
        }
        $2 ~ /^refs\/remotes\/origin\// {
            key = tolower($2)
            count[key]++
            refs[++n] = $2
            oids[n] = $1
            groups[n] = key
            if (NF > 2) live[key] = 1 # Never delete symbolic refs.
        }
        END {
            for (i = 1; i <= n; i++)
                if (count[groups[i]] > 1 && !live[groups[i]])
                    print oids[i], refs[i]
        }
    ') || return 1
    [[ -n "$collisions" ]] || return 1
    printf 'Pruning stale refs with case-colliding names one at a time.\n'
    while IFS=' ' read -r old_oid ref; do
        # Expected values protect concurrent updates; never remove lock files.
        git update-ref --no-deref -d "$ref" "$old_oid" || return 1
        printf ' * [pruned individually] %s\n' "${ref#refs/remotes/}"
    done <<< "$collisions"
}

usage() {
    printf 'Usage: git cleanup [--dry-run [--json] | --apply FILE]\n' >&2
    exit 2
}
dry_run=false
json=false
apply_file=''
while [[ $# -gt 0 ]]; do
    case "$1" in
        --dry-run) dry_run=true ;;
        --json) json=true ;;
        --apply) [[ $# -gt 1 ]] || usage; apply_file=$2; shift ;;
        *) usage ;;
    esac
    shift
done
if { $json && ! $dry_run; } || { $dry_run && [[ -n "$apply_file" ]]; }; then
    usage
fi
if [[ -n "$apply_file" && ! -r "$apply_file" ]]; then
    printf 'Cannot read approved actions: %s\n' "$apply_file" >&2
    exit 2
fi
if $json; then
    command -v python3 >/dev/null 2>&1 || { printf 'git cleanup --json requires Python 3.\n' >&2; exit 1; }
    # Keep stdout for the JSON inventory; progress and Git output go to stderr.
    exec 4>&1 1>&2
fi

if ! $dry_run && [[ -z "$apply_file" ]]; then
    command -v python3 >/dev/null 2>&1 || { printf 'git cleanup requires Python 3 for its checklist.\n' >&2; exit 1; }
    selector="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)/git-cleanup-select.py"
    [[ -r "$selector" ]] || { printf 'Missing checklist helper: %s\n' "$selector" >&2; exit 1; }
fi

current_worktree=$(git rev-parse --show-toplevel) || exit 1
current_branch=$(git symbolic-ref --quiet HEAD || true)
current_branch=${current_branch#refs/heads/}
prune_failed=false
if $dry_run; then
    git remote prune --dry-run origin || prune_failed=true
    git worktree prune --dry-run || exit 1
else
    git remote prune origin || prune_failed=true
    if $prune_failed && prune_case_collisions; then
        printf 'Case-colliding stale refs removed; retrying normal remote pruning.\n'
        git remote prune origin && prune_failed=false
    fi
    git worktree prune || exit 1
fi
status=0
if $prune_failed; then
    printf 'Remote ref pruning failed; continuing with local branch and worktree cleanup.\n' >&2
    status=1
fi
# Refresh only main, independently of the invoking worktree's branch. A dry
# run may download objects, but must not update refs or FETCH_HEAD.
if $dry_run; then
    remote_main=$(git ls-remote --exit-code origin refs/heads/main) || exit 1
    base_tip=${remote_main%%$'\t'*}
    if ! git cat-file -e "$base_tip^{commit}" 2>/dev/null; then
        git fetch --no-tags --no-write-fetch-head --refmap= origin "$base_tip" || exit 1
    fi
else
    git fetch --no-tags --no-write-fetch-head origin \
        '+refs/heads/main:refs/remotes/origin/main' || exit 1
    base_tip=$(git rev-parse --verify refs/remotes/origin/main) || exit 1
fi
printf 'Checking against refreshed origin/main (%s).\n' "${base_tip:0:12}"
now=$(date +%s) || exit 1
idle_cutoff=$((now - 7 * 24 * 60 * 60))

# NUL-delimited porcelain preserves unusual worktree paths.
worktree_paths=()
worktree_branches=()
worktree_locked=()
while IFS= read -r -d '' field; do
    case "$field" in
        'worktree '*)
            worktree_paths+=("${field#worktree }")
            worktree_branches+=('')
            worktree_locked+=(false)
            ;;
        'branch refs/heads/'*)
            worktree_branches[${#worktree_paths[@]}-1]=${field#branch refs/heads/}
            ;;
        locked|locked\ *) worktree_locked[${#worktree_paths[@]}-1]=true ;;
    esac
done < <(git worktree list --porcelain -z)

github_repo=''
origin_url=$(git config --get remote.origin.url)
case "$origin_url" in
    git@github.com:*) github_repo=${origin_url#git@github.com:} ;;
    https://github.com/*) github_repo=${origin_url#https://github.com/} ;;
    ssh://git@github.com/*) github_repo=${origin_url#ssh://git@github.com/} ;;
esac
github_repo=${github_repo%.git}
github_owner=${github_repo%%/*}
github_available=false
if [[ -n "$github_repo" ]]; then
    if command -v gh >/dev/null 2>&1; then
        github_available=true
    else
        printf 'GitHub CLI unavailable; PR merge checks are unavailable.\n' >&2
    fi
fi

# A private index lets us check the entire branch patch against main without
# touching any checkout, index, or ref. The files are cleaned up on exit.
scratch=$(mktemp -d "${TMPDIR:-/tmp}/git-cleanup.XXXXXXXX") || exit 1
trap 'rm -rf -- "$scratch"' EXIT
patch_index="$scratch/index"
patch_present_in_main() {
    local tip=$1 ancestor
    ancestor=$(git merge-base "$base_tip" "$tip") || return 1
    git diff --binary "$ancestor" "$tip" > "$scratch/branch.patch" || return 1
    [[ -s "$scratch/branch.patch" ]] || return 1
    GIT_INDEX_FILE="$patch_index" git -c core.splitIndex=false read-tree "$base_tip" || return 1
    GIT_INDEX_FILE="$patch_index" git -c core.splitIndex=false apply \
        --cached --reverse --check --whitespace=nowarn "$scratch/branch.patch" 2>/dev/null
}

# Shell aliases invoked in a linked worktree export its GIT_DIR. Clear those
# repository overrides when inspecting a different worktree's files or HEAD.
worktree_git() (
    unset GIT_DIR GIT_COMMON_DIR GIT_WORK_TREE GIT_INDEX_FILE
    git --no-optional-locks -C "$@"
)

# Collect every worktree and all eligible branch-only actions before asking
# for any selection. No branch or worktree deletion occurs during discovery.
entry_paths=()
entry_branches=()
entry_tips=()
entry_modes=()
entry_reasons=()
record_entry() {
    entry_paths+=("$path")
    entry_branches+=("$branch")
    entry_tips+=("$tip")
    entry_modes+=("$1")
    entry_reasons+=("$2")
}
keep_worktree() {
    if [[ -n "$path" ]]; then
        printf 'Keeping %s: %s.\n' "$branch" "$1"
        record_entry keep "$1"
    fi
}

branches=$(git for-each-ref --format='%(refname:strip=2) %(objectname)' refs/heads/) || exit 1
while IFS=' ' read -r branch tip <&3; do
    [[ -n "$branch" ]] || continue
    path=''
    linked_index=-1
    linked_count=0
    for ((i=0; i<${#worktree_paths[@]}; i++)); do
        if [[ "${worktree_branches[i]}" == "$branch" ]]; then
            path=${worktree_paths[i]}
            linked_index=$i
            linked_count=$((linked_count + 1))
        fi
    done
    if [[ $linked_count -gt 1 ]]; then
        for ((i=0; i<${#worktree_paths[@]}; i++)); do
            if [[ "${worktree_branches[i]}" == "$branch" ]]; then
                path=${worktree_paths[i]}
                keep_worktree 'branch is checked out in multiple worktrees'
            fi
        done
        continue
    fi
    case "$branch" in
        main|develop) keep_worktree 'protected branch'; continue ;;
    esac
    if [[ "$branch" == "$current_branch" ]] ||
       { [[ -n "$path" ]] && { [[ $linked_index == 0 ]] || [[ "$path" == "$current_worktree" ]]; }; }; then
        keep_worktree 'checked out in the main or current worktree'
        continue
    fi

    mode=''
    reason=''
    if [[ -n "$path" ]]; then
        if ! [[ -d "$path" ]]; then
            keep_worktree 'worktree path is missing; registration needs pruning'
            continue
        fi
        if ${worktree_locked[linked_index]}; then
            keep_worktree 'worktree is locked'
            status=1
            continue
        fi
        contains_worktree=false
        for child in "${worktree_paths[@]}"; do
            if [[ "$child" == "$path/"* && -d "$child" ]]; then
                contains_worktree=true
                break
            fi
        done
        if $contains_worktree; then
            keep_worktree 'contains another registered worktree; clean up children first'
            continue
        fi
        commit_time=$(git show -s --format=%ct "$tip") || { status=1; keep_worktree 'could not read branch commit'; continue; }
        if [[ $commit_time -le $idle_cutoff ]]; then
            mode=retain
            reason="idle: last commit $(((now - commit_time) / 86400)) days ago"
        fi
    fi
    if [[ -z "$mode" ]] && git merge-base --is-ancestor "$tip" "$base_tip"; then
        mode=delete
        reason='merged into origin/main by Git ancestry'
    fi
    # Query all PRs for this branch, with pagination, rather than a repository-
    # wide window of recent merges. Open PRs can also explain a retained branch.
    if [[ -z "$mode" && -n "$path" ]]; then
        reason='branch is not merged into origin/main'
        if $github_available; then
            if prs=$(gh api --method GET --paginate "repos/$github_repo/pulls" \
                -f "head=$github_owner:$branch" -f state=all -f per_page=100 \
                --jq '.[] | select(.head.repo.full_name == "'"$github_repo"'") | [.head.ref, .head.sha, (.merge_commit_sha // "-"), .number, (if .merged_at != null then "MERGED" else (.state | ascii_upcase) end), .base.ref] | @tsv'); then
                reason='no matching PR found; branch is not merged into origin/main'
                open_pr=''
                closed_pr=''
                merged_pr=''
                while IFS=$'\t' read -r pr_branch pr_tip merge_commit pr pr_state pr_base; do
                    [[ "$pr_branch" == "$branch" ]] || continue
                    case "$pr_state" in
                        OPEN) open_pr=$pr; continue ;;
                        CLOSED) closed_pr=$pr; continue ;;
                        MERGED) merged_pr=$pr ;;
                        *) continue ;;
                    esac
                    [[ "$pr_base" == main && "$merge_commit" != - ]] || continue
                    git merge-base --is-ancestor "$merge_commit" "$base_tip" 2>/dev/null || continue
                    if [[ "$tip" == "$pr_tip" ]]; then
                        mode=delete
                        reason="merged PR #$pr (exact branch tip)"
                        break
                    elif patch_present_in_main "$tip"; then
                        mode=retain
                        reason="review: merged PR #$pr has a different tip; complete branch patch is present in origin/main"
                        # Prefer an exact match if a reused branch has another PR.
                    fi
                done <<< "$prs"
                if [[ -z "$mode" ]]; then
                    if [[ -n "$open_pr" ]]; then
                        reason="open PR #$open_pr; branch is not confirmed merged"
                    elif [[ -n "$merged_pr" ]]; then
                        reason="merged PR #$merged_pr, but local changes are not confirmed in origin/main"
                    elif [[ -n "$closed_pr" ]]; then
                        reason="PR #$closed_pr was closed without merging"
                    fi
                fi
            else
                printf 'Could not check GitHub for %s.\n' "$branch" >&2
                reason='GitHub lookup failed; branch is not confirmed merged'
            fi
        elif [[ -n "$github_repo" ]]; then
            reason='GitHub CLI unavailable; branch is not confirmed merged'
        fi
    fi
    if [[ -z "$mode" ]]; then
        keep_worktree "$reason; last commit is less than 7 days old"
        continue
    fi
    if [[ -n "$path" ]]; then
        dirty=$(worktree_git "$path" status --porcelain --untracked-files=normal) || {
            status=1
            keep_worktree 'could not read worktree status'
            continue
        }
        if [[ -n "$dirty" ]]; then
            keep_worktree "worktree has uncommitted or untracked changes ($reason)"
            status=1
            continue
        fi
        printf 'Candidate %s: %s.\n' "$branch" "$reason"
        if $dry_run; then
            if [[ "$mode" == retain ]]; then
                printf 'Would remove worktree "%s" and retain branch "%s".\n' "$path" "$branch"
            else
                printf 'Would remove worktree "%s" and delete merged branch "%s".\n' "$path" "$branch"
            fi
        fi
    elif $dry_run; then
        printf 'Would delete merged branch %s.\n' "$branch"
    fi
    record_entry "$mode" "$reason"
done 3<<< "$branches"
for ((i=0; i<${#worktree_paths[@]}; i++)); do
    if [[ -z "${worktree_branches[i]}" ]]; then
        path=${worktree_paths[i]}
        branch=''
        tip=''
        reason='detached HEAD; no branch to retain'
        if [[ $i == 0 || "$path" == "$current_worktree" ]]; then
            reason='detached main or current worktree; protected checkout'
        fi
        printf 'Keeping worktree "%s": %s.\n' "$path" "$reason"
        record_entry keep "$reason"
    fi
done
# The NUL-separated inventory preserves spaces, quotes, and newlines in paths.
for ((i=0; i<${#entry_paths[@]}; i++)); do
    printf '%s\0' "${entry_paths[i]}" "${entry_branches[i]}" \
        "${entry_tips[i]}" "${entry_modes[i]}" "${entry_reasons[i]}"
done > "$scratch/inventory"
if $json; then
    python3 - "$scratch/inventory" "${worktree_paths[0]}" "$base_tip" "$status" >&4 <<'PY' || exit 1
import json, os, sys
fields = open(sys.argv[1], 'rb').read().split(b'\0')[:-1]
keys = ('path', 'branch', 'tip', 'mode', 'reason')
entries = [dict(zip(keys, (os.fsdecode(f) for f in fields[i:i + 5])))
           for i in range(0, len(fields), 5)]
print(json.dumps({'repository': sys.argv[2], 'origin_main': sys.argv[3],
                  'status': int(sys.argv[4]), 'entries': entries}, indent=2))
PY
fi
$dry_run && exit "$status"

selected=()
selected_flags=()
if [[ -n "$apply_file" ]]; then
    # Pre-approved actions name the mode, tip, and branch reported by a dry run.
    # Anything whose decision or tip has changed since then is skipped.
    while IFS=' ' read -r want_mode want_tip want_branch; do
        [[ -n "$want_mode$want_tip$want_branch" ]] || continue
        match=''
        for ((i=0; i<${#entry_paths[@]}; i++)); do
            if [[ "${entry_branches[i]}" == "$want_branch" && "${entry_tips[i]}" == "$want_tip" &&
                  "${entry_modes[i]}" == "$want_mode" && "$want_mode" != keep ]]; then
                match=$i
                break
            fi
        done
        if [[ -z "$match" ]]; then
            printf 'Skipping approved %s action for %s: it is no longer eligible.\n' \
                "$want_mode" "$want_branch" >&2
            status=1
        elif [[ -z "${selected_flags[match]-}" ]]; then
            selected_flags[match]=true
            selected+=("$match")
        fi
    done < "$apply_file"
    if [[ ${#selected[@]} == 0 ]]; then
        printf 'No approved actions remain eligible; nothing removed.\n'
        exit "$status"
    fi
else
    # The selector writes numeric inventory IDs only after one final confirmation.
    if python3 "$selector" "$scratch/inventory" "$scratch/selected"; then
        :
    else
        selector_status=$?
        if [[ $selector_status == 130 ]]; then
            printf 'Cleanup cancelled; no worktrees or branches removed.\n'
            exit "$status"
        fi
        exit 1
    fi
    while IFS= read -r row; do
        case "$row" in
            ''|*[!0-9]*) printf 'Invalid cleanup selection.\n' >&2; exit 1 ;;
        esac
        if [[ ${#row} -gt 6 ]] || [[ $row -ge ${#entry_paths[@]} ]] ||
           [[ "${entry_modes[row]}" == keep || -n "${selected_flags[row]-}" ]]; then
            printf 'Invalid cleanup selection.\n' >&2
            exit 1
        fi
        selected_flags[row]=true
        selected+=("$row")
    done < "$scratch/selected"
fi

# Recheck nesting as well as commit and checkout identity: another process may
# have created a child worktree while the checklist was open.
has_nested_worktree() {
    local field child
    while IFS= read -r -d '' field; do
        case "$field" in
            'worktree '*)
                child=${field#worktree }
                if [[ "$child" == "$1/"* && -d "$child" ]]; then
                    return 0
                fi
                ;;
        esac
    done < <(git worktree list --porcelain -z)
    return 1
}
completed=0
failed=0
for ((position=0; position<${#selected[@]}; position++)); do
    i=${selected[position]}
    path=${entry_paths[i]}
    branch=${entry_branches[i]}
    tip=${entry_tips[i]}
    mode=${entry_modes[i]}
    printf '\n[%s/%s] %s\n' "$((position + 1))" "${#selected[@]}" "$branch"
    if [[ "$(git rev-parse --verify "refs/heads/$branch")" != "$tip" ]]; then
        printf 'Keeping %s: branch changed since the cleanup check.\n' "$branch" >&2
        failed=$((failed + 1))
        status=1
        continue
    fi
    if [[ -n "$path" ]]; then
        if [[ "$(worktree_git "$path" symbolic-ref --quiet HEAD)" != "refs/heads/$branch" ]] ||
           has_nested_worktree "$path"; then
            printf 'Keeping %s: checkout changed or now contains another worktree.\n' "$branch" >&2
            failed=$((failed + 1))
            status=1
            continue
        fi
        printf 'Removing worktree "%s"...\n' "$path"
        if ! git worktree remove -- "$path"; then
            printf 'Keeping %s: worktree removal failed.\n' "$branch" >&2
            failed=$((failed + 1))
            status=1
            continue
        fi
        if [[ "$mode" == retain ]]; then
            printf 'Removed worktree; retained branch %s at %s.\n' "$branch" "${tip:0:12}"
            completed=$((completed + 1))
            continue
        fi
    fi
    if [[ "$(git rev-parse --verify "refs/heads/$branch")" == "$tip" ]]; then
        # Verification uses the frozen main commit, not the invoking HEAD or
        # branch upstream. Git still refuses deletion of a checked-out branch.
        if git branch -D -- "$branch"; then
            completed=$((completed + 1))
        else
            failed=$((failed + 1))
            status=1
        fi
    else
        printf 'Keeping %s: branch changed since the cleanup check.\n' "$branch" >&2
        failed=$((failed + 1))
        status=1
    fi
done
printf '\nBatch complete: %s actions completed; %s skipped or failed.\n' "$completed" "$failed"
exit "$status"
